/* Home */
"home.tagline" = "A plain, text-only widget for the apps you actually use.";
"home.what.title" = "What this is";
"home.what.body" = "PlainLaunch adds a Home Screen widget that lists the names of a few apps or actions in plain white text on a black background. Tap a name to open that app.";
"home.notALauncher.title" = "What this is not";
"home.notALauncher.body" = "PlainLaunch does not replace your Home Screen or iOS itself. It's a widget you place on your existing Home Screen, like any other widget.";
"home.privacy.title" = "Privacy";
"home.privacy.body" = "PlainLaunch has no account, no server, and no analytics. Your widget settings are stored only on this device (and shared with the widget via an App Group), never sent anywhere.";

/* Widget guide */
"guide.title" = "Add the widget";
"guide.subtitle" = "PlainLaunch works best as a Large widget on your Home Screen.";
"guide.step1" = "Touch and hold an empty area of your Home Screen until the icons jiggle.";
"guide.step2" = "Tap the + button in the top corner.";
"guide.step3" = "Search for “PlainLaunch”.";
"guide.step4" = "Choose the Large size, then tap “Add Widget”.";
"guide.step5" = "Tap Done. You can now tap any name on the widget to open that app.";
"guide.shortcutsTitle" = "Some entries need a Shortcut";
"guide.shortcutsBody" = "iOS doesn't let apps open Camera, Settings, or third-party apps like Soundcore directly. For those, PlainLaunch asks the Shortcuts app to run a small shortcut you create once. See the Test tab for exactly which ones, and the Shortcut names to use.";

